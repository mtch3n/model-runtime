[Unit]
Description=Local models for other programs, over a Unix socket
Documentation=https://github.com/mtch3n/model-runtime

[Service]
ExecStart=/usr/bin/model-runtime serve
Restart=on-failure
# It's sent the private text it looks through, so it must not reach the
# network. `model-runtime pull` downloads models outside this service.
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t

[Install]
WantedBy=default.target
